{#
  Catalog PDF — "grid" archetype (ADR-0027; editorial redesign #2608): a
  framed brand cover, a TWO-column table of contents, then a paginated 3-wide
  card grid. Rendered to HTML here, then to PDF by the PdfRenderer port
  (Dompdf default / Gotenberg).

  Card design: borderless — a tinted image panel (single-cell table for
  vertical centring), two-line clamped title, letterspaced SKU, bold price in
  the darkened accent. Cards separate by whitespace, not rules. The TOC is
  split into two columns via Twig slicing (no CSS multi-column in Dompdf);
  entry SKUs float right over a dotted hairline.

  Dompdf-safe CSS only (CSS 2.1 subset + border-radius): no flexbox, no grid,
  no CSS custom properties — brand tokens are interpolated by Twig straight
  into the <style> block. TOC page numbers need `target-counter()`, which
  Dompdf does not support: they stay gated behind the `premium` flag (false
  by default) and arrive with Gotenberg-class renderers; on Dompdf the TOC
  degrades gracefully to anchor links without page numbers.

  The template receives the product list plus the shared chrome context
  (palette / fonts / labels / generated_at / title / item_count) built by
  CatalogPdfChromeFactory for BOTH the PDF render and the wizard preview, and
  the optional `premium` bool. strict_variables is ON in the test env, so
  every access is guarded with `|default(...)` or `is defined`.
#}
{% set pal = palette|default({}) %}
{% set c_accent = pal.accent|default('#1d4ed8') %}
{% set c_accent_dark = pal.accent_dark|default('#143591') %}
{% set c_on_accent = pal.on_accent|default('#ffffff') %}
{% set c_on_accent_dark = pal.on_accent_dark|default('#ffffff') %}
{% set c_zebra = pal.tint_zebra|default('#f2f5fd') %}
{% set c_panel = pal.tint_panel|default('#f7f9fe') %}
{% set l = labels|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        {% include 'catalog/_chrome/fonts.html.twig' %}
        {% include 'catalog/_chrome/chrome.css.html.twig' %}
        .toc {
            page-break-after: always;
        }
        .toc-heading {
            font-family: 'Fraunces', 'DejaVu Serif', serif;
            font-weight: 600;
            font-size: 22px;
            margin: 0 0 4px 0;
        }
        .toc-rule {
            width: 64px;
            border-bottom: 3px solid {{ c_accent }};
            margin-bottom: 16px;
        }
        .toc-columns {
            width: 100%;
            border-collapse: collapse;
        }
        .toc-columns > tr > td,
        .toc-columns td.toc-col {
            width: 50%;
            vertical-align: top;
        }
        .toc-columns td.toc-col-left {
            padding-right: 14px;
        }
        .toc-columns td.toc-col-right {
            padding-left: 14px;
        }
        .toc-entry {
            border-bottom: 0.75px dotted #d9dce1;
            padding: 4px 0;
            font-size: 9.5px;
        }
        .toc-entry a {
            color: #16181d;
            text-decoration: none;
        }
        .toc-entry .toc-sku {
            float: right;
            font-size: 8px;
            letter-spacing: 0.8px;
            color: #9aa0a8;
        }
        {% if premium|default(false) %}
        /* Gotenberg-class renderers resolve the target page of each anchor. */
        .toc-entry a .toc-page:after {
            content: target-counter(attr(href url), page);
            float: right;
            color: #7d838c;
            font-size: 8.5px;
        }
        {% endif %}
        .grid {
            width: 100%;
            border-collapse: separate;
            border-spacing: 10px;
        }
        .grid td.card {
            width: 33%;
            vertical-align: top;
            page-break-inside: avoid;
        }
        .card-image {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 7px;
        }
        .card-image td {
            background-color: {{ c_panel }};
            height: 158px;
            text-align: center;
            vertical-align: middle;
        }
        .card-image img {
            max-width: 90%;
            max-height: 146px;
        }
        .card-placeholder {
            font-size: 7px;
            font-weight: 600;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #b9bec6;
        }
        .card-title {
            font-weight: 600;
            font-size: 10.5px;
            line-height: 1.35;
            {# Safety net only — the title is ellipsised in Twig (~2 lines),
               because Dompdf enforces the font's natural line box and a tight
               max-height would clip glyphs mid-descender. #}
            max-height: 34px;
            overflow: hidden;
            margin-bottom: 3px;
        }
        .card-sku {
            font-size: 7.5px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #9aa0a8;
            margin-bottom: 5px;
        }
        .card-price {
            font-weight: 700;
            font-size: 11px;
            color: {{ c_accent_dark }};
        }
    </style>
</head>
<body>
    {% include 'catalog/_chrome/footer.html.twig' %}
    {% include 'catalog/_chrome/cover.html.twig' %}

    {% set half = ((products|length + 1) / 2)|round(0, 'ceil') %}
    <div class="toc">
        <div class="eyebrow">{{ branding.company_name|default('') }}</div>
        <h2 class="toc-heading">{{ l.toc|default('Contents') }}</h2>
        <div class="toc-rule"></div>
        <table class="toc-columns">
            <tr>
                <td class="toc-col toc-col-left">
                    {% for product in products[:half] %}
                        <div class="toc-entry">
                            <a href="#product-{{ loop.index }}">{{ product.title|default('') }}<span class="toc-page"></span></a>
                            <span class="toc-sku">{{ product.sku|default('') }}</span>
                        </div>
                    {% endfor %}
                </td>
                <td class="toc-col toc-col-right">
                    {% for product in products[half:] %}
                        <div class="toc-entry">
                            <a href="#product-{{ half + loop.index }}">{{ product.title|default('') }}<span class="toc-page"></span></a>
                            <span class="toc-sku">{{ product.sku|default('') }}</span>
                        </div>
                    {% endfor %}
                </td>
            </tr>
        </table>
    </div>

    <table class="grid">
        {% for row in products|batch(3) %}
            <tr>
                {% for product in row %}
                    <td class="card" id="product-{{ loop.parent.loop.index0 * 3 + loop.index }}">
                        <table class="card-image">
                            <tr>
                                <td>
                                    {% if product.image is defined and product.image %}
                                        <img src="{{ product.image }}" alt="">
                                    {% else %}
                                        <span class="card-placeholder">{{ l.no_image|default('no image') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                        {% set card_title = product.title|default('') %}
                        <div class="card-title">{{ card_title|length > 64 ? card_title[:61] ~ '…' : card_title }}</div>
                        <div class="card-sku">{{ product.sku|default('') }}</div>
                        {% if product.price is defined and product.price %}
                            <div class="card-price">{{ product.price }}</div>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
    </table>
</body>
</html>
