{#
  Catalog PDF — "pricelist" archetype (ADR-0027; editorial redesign #2608): a
  framed brand cover, a title block, then one editorial price table. Rendered
  to HTML here, then to PDF by the PdfRenderer port (Dompdf default /
  Gotenberg).

  Table design: no vertical rules — small-caps letterspaced column headings
  over a 2px accent rule, subtle zebra tint, hairline row separators, prices
  right-aligned in bold ink (Inter's tabular digits align the columns without
  font-variant support). The repeating column header uses `<thead>` +
  `display: table-header-group`, which Dompdf re-emits at the top of every
  page the table spans. Localised column headings come from the chrome
  `labels` map; the palette is derived server-side by CatalogPdfPalette.

  Dompdf-safe CSS only (CSS 2.1 subset + border-radius): no flexbox, no grid,
  no CSS custom properties — brand tokens are interpolated by Twig straight
  into the <style> block below.

  The template receives the product list plus the shared chrome context
  (palette / fonts / labels / generated_at / title / item_count) built by
  CatalogPdfChromeFactory for BOTH the PDF render and the wizard preview.
  strict_variables is ON in the test env, so every access is guarded with
  `|default(...)` or `is defined`.
#}
{% set pal = palette|default({}) %}
{% set c_accent = pal.accent|default('#1d4ed8') %}
{% set c_accent_dark = pal.accent_dark|default('#143591') %}
{% set c_on_accent = pal.on_accent|default('#ffffff') %}
{% set c_on_accent_dark = pal.on_accent_dark|default('#ffffff') %}
{% set c_zebra = pal.tint_zebra|default('#f2f5fd') %}
{% set c_panel = pal.tint_panel|default('#f7f9fe') %}
{% set l = labels|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        {% include 'catalog/_chrome/fonts.html.twig' %}
        {% include 'catalog/_chrome/chrome.css.html.twig' %}
        .list-head {
            margin-bottom: 18px;
        }
        .list-title {
            font-family: 'Fraunces', 'DejaVu Serif', serif;
            font-weight: 600;
            font-size: 24px;
            margin: 0 0 6px 0;
        }
        .list-meta {
            font-size: 9.5px;
            color: #7d838c;
            letter-spacing: 0.4px;
        }
        .pricelist {
            width: 100%;
            border-collapse: collapse;
        }
        .pricelist thead {
            display: table-header-group;
        }
        .pricelist th {
            text-align: left;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #7d838c;
            border-bottom: 2px solid {{ c_accent }};
            padding: 7px 9px;
        }
        .pricelist th.col-price {
            text-align: right;
        }
        .pricelist td {
            padding: 7px 9px;
            border-bottom: 0.75px solid #eef0f3;
            font-size: 10.5px;
        }
        .pricelist tr {
            page-break-inside: avoid;
        }
        .pricelist tr.alt td {
            background-color: {{ c_zebra }};
        }
        .pricelist td.sku {
            width: 110px;
            font-size: 9px;
            letter-spacing: 0.8px;
            color: #9aa0a8;
            white-space: nowrap;
        }
        .pricelist td.name {
            font-weight: 600;
        }
        .pricelist td.price {
            width: 110px;
            text-align: right;
            font-weight: 700;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    {% include 'catalog/_chrome/footer.html.twig' %}
    {% include 'catalog/_chrome/cover.html.twig' %}

    <div class="list-head">
        <div class="eyebrow">{{ branding.company_name|default('') }}</div>
        <h1 class="list-title">{{ title|default('') }}</h1>
        <div class="list-meta">{{ labels.items|default('') }} &middot; {{ generated_at|default('') }}</div>
    </div>

    <table class="pricelist">
        <thead>
            <tr>
                <th>{{ l.sku|default('SKU') }}</th>
                <th>{{ l.name|default('Name') }}</th>
                <th class="col-price">{{ l.price|default('Price') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr{% if loop.index is even %} class="alt"{% endif %}>
                    <td class="sku">{{ product.sku|default('') }}</td>
                    <td class="name">{{ product.name|default('') }}</td>
                    <td class="price">{{ product.price|default('') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
