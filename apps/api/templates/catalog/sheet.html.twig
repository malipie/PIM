{#
  Catalog PDF — "sheet" archetype (ADR-0027; editorial redesign #2608): a
  framed brand cover, then one product data sheet per page. Rendered to HTML
  here, then to PDF by the PdfRenderer port (Dompdf default / Gotenberg).

  Page anatomy: small-caps company eyebrow, title row (Fraunces serif title
  left, rounded price chip right), letterspaced SKU line, a tinted image panel
  (vertical centring via a single-cell table — Dompdf-safe), the description,
  and a zebra specification table with humanised labels. Static chrome strings
  (specification heading, "no image" placeholder, footer) come from the
  localised `labels` map; the palette is derived server-side by
  CatalogPdfPalette — Dompdf has no CSS colour functions.

  Dompdf-safe CSS only (CSS 2.1 subset + border-radius): no flexbox, no grid,
  no CSS custom properties (`var(--x)` is not resolved reliably) — brand
  tokens are interpolated by Twig straight into the <style> block below.

  The template receives the product list plus the shared chrome context
  (palette / fonts / labels / generated_at / title / item_count) built by
  CatalogPdfChromeFactory for BOTH the PDF render and the wizard preview.
  strict_variables is ON in the test env, so every access is guarded with
  `|default(...)` or `is defined`.
#}
{% set pal = palette|default({}) %}
{% set c_accent = pal.accent|default('#1d4ed8') %}
{% set c_accent_dark = pal.accent_dark|default('#143591') %}
{% set c_on_accent = pal.on_accent|default('#ffffff') %}
{% set c_on_accent_dark = pal.on_accent_dark|default('#ffffff') %}
{% set c_zebra = pal.tint_zebra|default('#f2f5fd') %}
{% set c_panel = pal.tint_panel|default('#f7f9fe') %}
{% set l = labels|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        {% include 'catalog/_chrome/fonts.html.twig' %}
        {% include 'catalog/_chrome/chrome.css.html.twig' %}
        .sheet {
            page-break-after: always;
        }
        .sheet-last {
            page-break-after: auto;
        }
        .sheet-head {
            border-bottom: 0.75px solid #e3e5e9;
            padding-bottom: 8px;
            margin-bottom: 22px;
        }
        .title-row {
            width: 100%;
            margin-bottom: 4px;
        }
        .product-title {
            font-family: 'Fraunces', 'DejaVu Serif', serif;
            font-weight: 600;
            font-size: 28px;
            line-height: 1.15;
            margin: 0;
        }
        .price-cell {
            width: 150px;
            text-align: right;
            vertical-align: top;
        }
        .price-chip {
            display: inline-block;
            background-color: {{ c_accent }};
            color: {{ c_on_accent }};
            border-radius: 14px;
            padding: 7px 16px;
            font-size: 12.5px;
            font-weight: 700;
            white-space: nowrap;
        }
        .product-sku {
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #9aa0a8;
            margin: 6px 0 0 0;
        }
        .img-panel {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0 22px 0;
        }
        .img-panel td {
            background-color: {{ c_panel }};
            height: 396px;
            text-align: center;
            vertical-align: middle;
        }
        .img-panel img {
            max-width: 92%;
            max-height: 372px;
        }
        .img-placeholder {
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #b9bec6;
        }
        .product-description {
            font-size: 11.5px;
            line-height: 1.6;
            color: #2a2d34;
            margin-bottom: 22px;
        }
        .specs-heading {
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #9aa0a8;
            border-bottom: 2px solid {{ c_accent }};
            padding-bottom: 5px;
            margin-bottom: 2px;
        }
        .specs {
            width: 100%;
            border-collapse: collapse;
        }
        .specs td {
            padding: 6px 10px;
            font-size: 10.5px;
            border-bottom: 0.75px solid #eef0f3;
        }
        .specs tr.alt td {
            background-color: {{ c_zebra }};
        }
        .specs td.spec-label {
            width: 38%;
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #7d838c;
        }
    </style>
</head>
<body>
    {% include 'catalog/_chrome/footer.html.twig' %}
    {% include 'catalog/_chrome/cover.html.twig' %}

    {% for product in products %}
        <div class="sheet{% if loop.last %} sheet-last{% endif %}">
            <div class="sheet-head">
                <span class="eyebrow">{{ branding.company_name|default('') }}</span>
            </div>

            <table class="title-row">
                <tr>
                    <td><h1 class="product-title">{{ product.title|default('') }}</h1></td>
                    {% if product.price is defined and product.price %}
                        <td class="price-cell"><span class="price-chip">{{ product.price }}</span></td>
                    {% endif %}
                </tr>
            </table>
            <div class="product-sku">{{ product.sku|default('') }}</div>

            <table class="img-panel">
                <tr>
                    <td>
                        {% if product.image is defined and product.image %}
                            <img src="{{ product.image }}" alt="">
                        {% else %}
                            <span class="img-placeholder">&mdash; {{ l.no_image|default('no image') }} &mdash;</span>
                        {% endif %}
                    </td>
                </tr>
            </table>

            {% if product.description is defined and product.description %}
                {# Already sanitised upstream by HtmlValueSanitizer — safe to print raw. #}
                <div class="product-description">{{ product.description|raw }}</div>
            {% endif %}

            {% if product.specs is defined and product.specs %}
                <div class="specs-heading">{{ l.specification|default('Specification') }}</div>
                <table class="specs">
                    {% for row in product.specs %}
                        <tr{% if loop.index is odd %} class="alt"{% endif %}>
                            <td class="spec-label">{{ row.label|default('')|replace({'_': ' ', '-': ' '})|capitalize }}</td>
                            <td class="spec-value">{{ row.value|default('') }}</td>
                        </tr>
                    {% endfor %}
                </table>
            {% endif %}
        </div>
    {% endfor %}
</body>
</html>
