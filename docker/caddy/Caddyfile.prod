# PIM edge Caddy — PRODUCTION site (single-origin, same topology as dev).
#
# Mounted over /etc/caddy/Caddyfile by docker-compose.prod.yml. Differences
# from the dev Caddyfile (docker/caddy/Caddyfile):
#   - real domain from {$DOMAIN} with automatic Let's Encrypt TLS
#     (no local_certs, no debug),
#   - the SPA is the BUILT bundle served by file_server from /srv/admin
#     (apps/admin/dist mounted read-only) — no Vite dev server,
#   - /docs* serves the generated documentation site from /srv/docs
#     (apps/docs/dist) with a docs-scoped CSP,
#   - CSP script-src drops 'unsafe-inline'/'unsafe-eval' — the built
#     admin bundle has one external module script, no inline, no eval
#     (AUD-074).
#
# Route order (most specific handle wins):
#   /.well-known/mercure → Mercure hub (SSE)
#   /api/metrics         → 404 blackhole (#2729 — Prometheus scrapes api:80
#                          over the internal network, never the edge)
#   /api/*               → FrankenPHP / Symfony / API Platform
#   /docs/*              → static docs site
#   /*                   → static admin SPA (index.html fallback for the router)

{
    email {$ACME_EMAIL}
}

(common_security_prod) {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        -Server
        -X-Powered-By
    }
}

# `localhost` rides along for the container healthcheck (base compose probes
# https://localhost/api with --no-check-certificate); Caddy issues an internal
# self-signed cert for it while {$DOMAIN} gets a real ACME certificate.
# ─── Trasy jednej instancji PIM (epik TNT, #2856) ────────────────────────────
#
# Snippet przyjmuje dwa argumenty, żeby ten sam komplet tras obsługiwał stack
# współdzielony i instancję dowolnego tenanta:
#   {args[0]} — host kontenera api      (np. `api` albo `pim-acme-api`)
#   {args[1]} — host kontenera mercure  (np. `mercure` albo `pim-acme-mercure`)
#
# Bundel SPA i dokumentacja są WSPÓLNE (są origin-relative, więc ten sam
# artefakt obsługuje każdą subdomenę) — dlatego nie są parametryzowane.
#
# Dołożenie tenanta to pięć linii na dole tego pliku. Docelowo znika i to,
# gdy wejdzie routing dynamiczny z on-demand TLS (#2908).
(pim_routes) {
    import common_security_prod

    # Mercure hub — must precede the /api* matcher.
    handle /.well-known/mercure* {
        reverse_proxy {args[1]}:80
    }

    # #2729 — metrics stay internal-only.
    handle /api/metrics* {
        respond 404
    }

    handle /api* {
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        # Edge backstop on request body size (IMP2-2.8): Caddy 150MB >
        # php.ini post_max_size 110MB > application limit 100MB, so the
        # readable RFC 7807 error from the app fires first on normal
        # oversizes and the edge only stops extreme payloads.
        request_body {
            max_size 150MB
        }
        reverse_proxy {args[0]}:80
    }

    # Documentation site (user guides + API reference) — static build
    # published by the docs pipeline into /srv/docs.
    #
    # VitePress emits the page-chunk hash map as an INLINE script
    # (window.__VP_HASH_MAP__). Under the strict policy the browser blocked
    # it, the client router could not resolve the chunk for a clicked page
    # and in-site navigation silently died — direct URLs worked (server-
    # rendered HTML), every menu link did not. Hence 'unsafe-inline' scoped
    # to this subtree only; the docs are static, take no user input and
    # carry no session.
    handle_path /docs* {
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        root * /srv/docs
        # {path}.html obsługuje czyste adresy z VitePressa (cleanUrls):
        # /docs/selfhost serwuje selfhost.html. Bezpośrednie linki z .html
        # dalej działają, bo pierwszy warunek trafia w plik.
        try_files {path} {path}.html {path}/index.html
        file_server
    }

    # Brakująca podstrona dokumentacji spadała na /index.html i wracała jako
    # 200 ze stroną główną — mylące dla czytelnika i dla wyszukiwarek. Docs
    # nie ma już fallbacku w try_files, więc file_server zgłasza błąd 404,
    # a ten blok podaje wygenerowane przez VitePress 404.html z właściwym
    # kodem. `handle_errors` musi stać na poziomie site'u (Caddy nie pozwala
    # zagnieździć go w handle_path). Zasięg ograniczony matcherem: SPA ma
    # własny fallback i nigdy tu nie trafia, a /api zwraca odpowiedzi z
    # backendu, które nie są błędami Caddy'ego.
    handle_errors {
        @docs404 expression {err.status_code} == 404 && path('/docs/*')
        handle @docs404 {
            root * /srv/docs
            rewrite * /404.html
            file_server {
                status 404
            }
        }
    }

    # Admin SPA — built bundle, client-side router fallback to index.html.
    handle {
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}

# ─── Instancje ───────────────────────────────────────────────────────────────

# Stack współdzielony. `localhost` jedzie razem dla healthchecku kontenera
# (base compose sonduje https://localhost/api); Caddy wystawia mu certyfikat
# wewnętrzny, a {$DOMAIN} dostaje prawdziwy z ACME.
{$DOMAIN}, localhost {
    import pim_routes api mercure
}

# Instancja tenanta — WZORZEC. Skrypt provisioningu (#2861) wypisuje gotowy
# blok do wklejenia; dopóki nie ma routingu dynamicznego (#2908), dokłada się
# go tutaj ręcznie i przeładowuje Caddy'ego:
#
#   acme.{$DOMAIN} {
#       import pim_routes pim-acme-api pim-acme-mercure
#   }
#
# Nazwy hostów pochodzą z aliasów sieciowych w docker-compose.tenant.yml,
# więc zgadzają się z kodem tenanta bez dodatkowej konfiguracji.

# Stary adres bez subdomeny — 301 na instancję `harmon`.
#
# Po przeniesieniu pierwszego klienta na `harmon.{$DOMAIN}` adres bez
# subdomeny musi dalej działać: prowadzą do niego zakładki operatora ORAZ
# linki w już wysłanych zaproszeniach i resetach hasła. Przekierowanie jest
# trwałe i zachowuje ścieżkę oraz query.
#
# UWAGA: włączyć DOPIERO po wystawieniu certyfikatu dla harmon.{$DOMAIN}
# i potwierdzeniu logowania pod nowym adresem — inaczej odcina jedyną
# działającą drogę do panelu.
#
#   {$DOMAIN} {
#       import common_security_prod
#       redir https://harmon.{$DOMAIN}{uri} permanent
#   }
