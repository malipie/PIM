# ═══════════════════════════════════════════════════════════════════════════
# Harmon PIM — Caddy/FrankenPHP: strona marketingowa harmonpim.pl
#
# Port reguł z serwer/nginx-harmonpim.conf. Caddy zamiast nginx, bo docelowo
# ten sam serwer obsługuje app.harmonpim.pl (stack PIM stoi na Caddy) — dwa
# serwery WWW nie mogą jednocześnie trzymać portów 80/443.
#
# FrankenPHP = Caddy + PHP w jednym procesie, więc mail.php działa bez php-fpm.
#
# ETAP OBECNY: brak domeny → nasłuch na :80, bez TLS, dostęp po gołym IP.
# PO KUPIENIU DOMENY: patrz blok "PRZEŁĄCZENIE NA DOMENĘ" na końcu pliku.
# ═══════════════════════════════════════════════════════════════════════════

{
	frankenphp
	auto_https off
	admin off
}

:80 {
	root * /srv/site
	encode zstd gzip

	# ── nagłówki bezpieczeństwa ──────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}

	# CSP: strona nie ma inline JS (fonty i logotypy są self-hosted), więc
	# script-src zostaje bez 'unsafe-inline'. style-src potrzebuje
	# 'unsafe-inline' — szablon używa atrybutów style="" (335 wystąpień).
	#
	# Google Analytics (gtag.js, G-ZP9WLBSRGT): loader siedzi w self-hostowanym
	# site.js, więc z zewnętrznych źródeł dochodzi tylko biblioteka gtag
	# (script-src) plus endpointy zbierające trafienia — GA4 wysyła je na
	# regionalne hosty (region1.google-analytics.com itd.), stąd wildcardy
	# w connect-src. img-src pokrywa starszy transport przez piksel.
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# `route` wymusza kolejność z pliku zamiast domyślnej kolejności dyrektyw
	# Caddy'ego — blokady (dotfiles, obce .php) przed serwowaniem plików.
	route {
		# ── dotfiles (.htaccess, .git…) — 404, poza /.well-known ──────────
		@dotfiles {
			path_regexp (^|/)\.
			not path /.well-known/*
		}
		respond @dotfiles 404

		# ── tylko mail.php wykonuje PHP; każdy inny .php → 404 ────────────
		@obce_php {
			path *.php
			not path /mail.php
		}
		respond @obce_php 404

		# ── cache: assety długo, HTML zawsze świeży ───────────────────────
		@immutable path /assets/* *.webp *.png *.svg *.woff2
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path *.html /
		header @html Cache-Control "no-cache"

		# ── serwowanie: statyki + ładne adresy + mail.php ─────────────────
		php_server
	}

	# ── strona 404 z zachowanym kodem odpowiedzi ──────────────────────────
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}

# ═══════════════════════════════════════════════════════════════════════════
# PRZEŁĄCZENIE NA DOMENĘ (po kupieniu harmonpim.pl i ustawieniu rekordów A)
#
# 1. Usuń `auto_https off` z bloku globalnego i dopisz `email <adres>`
#    (Let's Encrypt wysyła tam ostrzeżenia o wygasających certyfikatach).
# 2. Zamień `:80 {` na `harmonpim.pl {`.
# 3. Dopisz przekierowanie www → bez www:
#
#      www.harmonpim.pl {
#          redir https://harmonpim.pl{uri} permanent
#      }
#
# 4. W docker-compose.yml odkomentuj port 443 (TCP i UDP — HTTP/3).
# 5. `docker compose up -d --force-recreate` — certyfikat wystawi się sam.
# ═══════════════════════════════════════════════════════════════════════════
